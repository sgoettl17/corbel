# Template only, no real values. Copy to .env (git-ignored) or set these in your shell.
# Use sandbox values for testing. Never commit real credentials.

# Procore app credentials (client credentials grant)
CORBEL_CLIENT_ID=
CORBEL_CLIENT_SECRET=

# Numeric Procore company ID, sent as the Procore-Company-Id header
CORBEL_COMPANY_ID=

# production or sandbox (default: production)
CORBEL_ENVIRONMENT=sandbox

# Set to true to enable the create/update/delete tools (default: false)
CORBEL_ALLOW_WRITES=false

# Optional: use an existing access token instead of client ID and secret
CORBEL_ACCESS_TOKEN=
